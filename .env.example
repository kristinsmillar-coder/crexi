# Commercial Real Estate Scraper Configuration

# Rate Limiting (requests per minute)
RATE_LIMIT=30

# Request Timeout (seconds)
REQUEST_TIMEOUT=30

# User Agent (leave empty for random)
USER_AGENT=

# Output Directory
OUTPUT_DIR=output

# Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Headless Browser (for sites requiring JavaScript)
HEADLESS=true

# Proxy (optional, format: http://user:pass@host:port)
PROXY=
